{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "if [ -d ~/knowledge/.git ]; then git -C ~/knowledge pull -q --ff-only || true; else git clone -q git@github.com:Tora29/knowledge.git ~/knowledge; fi"
          },
          {
            "type": "command",
            "command": "echo 'コードを書く前に ~/knowledge/INDEX.md を読み、作業に関係するルールだけを Read すること。'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "onFailure": "block",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guardrail.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "onFailure": "block",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "onFailure": "block",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr-gate.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/qa-bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/knowledge-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/log-event.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/knowledge-read.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/log-event.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/log-event.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/log-event.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "foundation:qa-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/save-qa-result.sh"
          }
        ]
      }
    ]
  }
}
