{
  "hooks": {
    "SubagentStop": [
      { "matcher": "qa:qa-reviewer", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/save-qa-result.sh" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "if": "Bash(gh *)", "onFailure": "block", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr-gate.sh" },
        { "type": "command", "if": "Bash(git push*)", "onFailure": "block", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr-gate.sh" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/qa-bash-guard.sh" }
      ] }
    ]
  }
}
